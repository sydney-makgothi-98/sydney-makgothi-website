    f = uifigure('Name', tableFigName, ...
                 'Position', [80 80 1620 780]);

    uit = uitable(f, ...
        'Data', T, ...
        'ColumnName', {'Result', 'CEM', 'FEM'}, ...
        'ColumnWidth', {1050, 135, 135}, ...
        'Position', [30 40 1550 700], ...
        'FontName', 'Arial', ...
        'FontSize', 12, ...
        'RowStriping', 'on', ...
        'ColumnEditable', false);

    uit.BackgroundColor = [1 1 1; 0.96 0.98 1.00];
end

