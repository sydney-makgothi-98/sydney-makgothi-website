% ── LOCAL HELPER ─────────────────────────────────────────────
% function plot_ring(ax_, x_, y_, z_, col_, lw_)
%     plot3(ax_, [x_, x_(1)], [y_, y_(1)], z_*ones(1,length(x_)+1), ...
%           'Color', col_, 'LineWidth', lw_);
% end


% ======================================== ADDITIONAL APPROACHS =============================================== %



%_______________________________________________________________________________________________________________________________________________________
%
%                                                                  PRESSURE
%                                                                  METHOD 2 — MOMENT MATRIX
%
%________________________________________________________________________________________________________________________________________________________

% % ── LOOP 1: Build force and application-point arrays ─────────────────────
% Fpx_array_M2   = [];
% Fpy_array_M2   = [];
% x_force_array  = [];
% y_force_array  = [];
% 
% idx = 1;
% while idx <= length(x_outer) - 1
% 
%     dx_seg = x_outer(idx+1) - x_outer(idx);
%     dy_seg = y_outer(idx+1) - y_outer(idx);
% 
%     Fpx_seg = p_MPa * L *  dy_seg;
%     Fpy_seg = p_MPa * L * -dx_seg;
% 
%     x_force = (x_outer(idx) + x_outer(idx+1)) / 2;
%     y_force = (y_outer(idx) + y_outer(idx+1)) / 2;
% 
%     Fpx_array_M2  = [Fpx_array_M2,  Fpx_seg];
%     Fpy_array_M2  = [Fpy_array_M2,  Fpy_seg];
%     x_force_array = [x_force_array, x_force];
%     y_force_array = [y_force_array, y_force];
% 
%     idx = idx + 1;
% 
% end
% 
% n_forces = length(Fpx_array_M2);
% n_points = length(x_mid_array);
% 
% % ── LOOP 2+3: Build lower-triangular Moment_Matrix ───────────────────────
% %
% %   Moment_Matrix(j, i) = moment that segment i generates about point j
% %   Only upstream segments (i < j) are non-zero — lower triangle only.
% %
% Moment_Matrix = zeros(n_points, n_forces);
% 
% ref_idx = 1;
% while ref_idx <= n_points
% 
%     x_ref_j = x_mid_array(ref_idx);
%     y_ref_j = y_mid_array(ref_idx);
% 
%     seg_idx = 1;
%     while seg_idx <= ref_idx - 1
% 
%         arm_x = x_force_array(seg_idx) - x_ref_j;
%         arm_y = y_force_array(seg_idx) - y_ref_j;
% 
%         Moment_Matrix(ref_idx, seg_idx) = Fpx_array_M2(seg_idx) * arm_y ...
%                                         - Fpy_array_M2(seg_idx) * arm_x;
% 
%         seg_idx = seg_idx + 1;
%     end
% 
%     ref_idx = ref_idx + 1;
% end
% 
% % ── Total particular moment at each reference point ───────────────────────
% Mp_M2 = sum(Moment_Matrix, 2)';   % 1 x n_points
% 
% % ── Pressure RHS for flexibility equations ───────────────────────────────
% pressure_rhs_M2 = [
%     trapz(s_array_mid, Mp_M2 .* inverse_bending_stiffness);
%     trapz(s_array_mid, Mp_M2 .* delta_y .* inverse_bending_stiffness);
%     trapz(s_array_mid, Mp_M2 .* delta_x .* inverse_bending_stiffness)
% ];
% 
% % ── Solve for redundants ──────────────────────────────────────────────────
% internal_loads_M2 = integral_matrix \ -pressure_rhs_M2;
% 
% Ma_M2 = internal_loads_M2(1);
% Na_M2 = internal_loads_M2(2);
% Va_M2 = internal_loads_M2(3);
% 
% fprintf('\n=== Method 2 — Pressure redundants ===\n');
% fprintf('Ma_M2 = %.6e N·mm\n', Ma_M2);
% fprintf('Na_M2 = %.6e N\n',    Na_M2);
% fprintf('Va_M2 = %.6e N   (should be ~0 by symmetry)\n', Va_M2);
% 
% % ── Total internal loads ──────────────────────────────────────────────────
% theta_array_M2 = atan2(ty, tx);   % true local tangent angle, 1 x n_pts
% 
% N_M2 = Na_M2 .* cos(theta_array_M2) + Va_M2 .* sin(theta_array_M2);   % 1 x n_pts
% 
% M_M2 = Mp_M2 + Ma_M2 + Na_M2 .* delta_y + Va_M2 .* delta_x;           % 1 x n_pts
% 
% % ── Circumferential stress (outer fibre) ─────────────────────────────────
% sigma_M2 = N_M2 ./ A_array + (M_M2 .* c_array) ./ inertia_moment;     % 1 x n_pts
% 
% % ── Displacement field — Method 2 ────────────────────────────────────────
% fwd_MEI_M2  = cumtrapz(s_array_mid, M_M2 .* inv_EI);
% fwd_MxEI_M2 = cumtrapz(s_array_mid, M_M2 .* x_mid_array .* inv_EI);
% fwd_MyEI_M2 = cumtrapz(s_array_mid, M_M2 .* y_mid_array .* inv_EI);
% 
% tail_MEI_M2  = fwd_MEI_M2(end)  - fwd_MEI_M2;
% tail_MxEI_M2 = fwd_MxEI_M2(end) - fwd_MxEI_M2;
% tail_MyEI_M2 = fwd_MyEI_M2(end) - fwd_MyEI_M2;
% 
% delta_rot_M2 = tail_MEI_M2;
% delta_v_M2   = x_mid_array .* tail_MEI_M2 - tail_MxEI_M2;
% delta_h_M2   = tail_MyEI_M2 - y_mid_array .* tail_MEI_M2;

% fprintf('\n=== Method 2 — Displacement verification ===\n')
% fprintf('Rotation at s=0 : %+.6e rad  (target: 0)\n', delta_rot_M2(1))
% fprintf('Vert.    at s=0 : %+.6e mm   (target: 0)\n', delta_v_M2(1))
% fprintf('Horiz.   at s=0 : %+.6e mm   (target: 0)\n', delta_h_M2(1))
% 
% % ── Comparison plots ──────────────────────────────────────────────────────
% figure(11)
% plot(s_array_mid, Mp,    'b--', 'LineWidth', 1.2); hold on
% plot(s_array_mid, Mp_M2, 'r--', 'LineWidth', 1.2);
% yline(0, 'k--'); grid on
% legend('M_0 method 1', 'M_0 method 2', 'Location', 'best')
% xlabel('Arc length s [mm]'); ylabel('M_0 [N·mm]')
% title('Particular moment — method 1 vs method 2')
% 
% figure(12)
% plot(s_array_mid, M_Q2, 'b', 'LineWidth', 1.5); hold on
% plot(s_array_mid, M_M2, 'r', 'LineWidth', 1.5);
% yline(0, 'k--'); grid on
% legend('M_{total} method 1', 'M_{total} method 2', 'Location', 'best')
% xlabel('Arc length s [mm]'); ylabel('M [N·mm]')
% title('Total moment — method 1 vs method 2')
% 
% figure(13)
% plot(s_array_mid, sigma_Q2, 'b', 'LineWidth', 1.5); hold on
% plot(s_array_mid, sigma_M2, 'r', 'LineWidth', 1.5);
% yline(0, 'k--'); grid on
% legend('\sigma method 1', '\sigma method 2', 'Location', 'best')
% xlabel('Arc length s [mm]'); ylabel('\sigma [MPa]')
% title('Circumferential stress — method 1 vs method 2')
% 
% figure(14)
% theta_mid = s_array_mid ./ s_total_mid .* (2*pi);
% subplot(3,1,1)
% plot(theta_mid, delta_rot_M2, 'k', 'LineWidth', 1.5)
% yline(0,'k--'); grid on
% xlabel('\theta [rad]'); ylabel('\phi [rad]')
% title('Rotation \phi(s) — Method 2')
% 
% subplot(3,1,2)
% plot(theta_mid, delta_h_M2, 'b', 'LineWidth', 1.5)
% yline(0,'b--'); grid on
% xlabel('\theta [rad]'); ylabel('u_x [mm]')
% title('Horizontal displacement u_x(s) — Method 2')
% 
% subplot(3,1,3)
% plot(theta_mid, delta_v_M2, 'r', 'LineWidth', 1.5)
% yline(0,'r--'); grid on
% xlabel('\theta [rad]'); ylabel('u_y [mm]')
% title('Vertical displacement u_y(s) — Method 2')


