tableFigName = 'CEM Poster Results Table';

% Check if the figure already exists → reuse it instead of creating a new one
existingFig = findall(groot, 'Type', 'Figure', 'Name', tableFigName);

if ~isempty(existingFig)
    figure(existingFig);          % Bring existing figure to front
    uit = findobj(existingFig, 'Type', 'uitable');  % Reuse the table
    uit.Data = T;                 % Update data in case values changed
else
