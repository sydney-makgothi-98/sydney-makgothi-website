% % ── EXTRACT FIRST SEGMENT ────────────────────────────────────
% total_pts   = length(x_outer);
% pts_per_seg = floor(total_pts / num_sections);
% idx_seg     = 1 : pts_per_seg;
% 
% xo = x_outer(idx_seg);      yo = y_outer(idx_seg);
% xi = x_inner(idx_seg);      yi = y_inner(idx_seg);
% xm = x_mid_array(idx_seg);  ym = y_mid_array(idx_seg);
% 
% % Arc-length along the first segment (for dimensioning)
% dso  = sqrt(diff(xo).^2 + diff(yo).^2);
% s_seg = [0, cumsum(dso)];
% 
% % ── COLOUR PALETTE ───────────────────────────────────────────
% col_outer = [0.00 0.45 0.74];   % blue
% col_mid   = [0.47 0.67 0.19];   % green
% col_inner = [0.85 0.33 0.10];   % orange-red
