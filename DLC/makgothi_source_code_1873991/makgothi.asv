% 
% % ── THICKNESS ANNOTATION (at mid-arc, radial direction) ──────
% mid_idx = round(pts_per_seg / 2);
% % Radial outward unit vector at mid-point (points away from origin)
% r_vec   = [xm(mid_idx), ym(mid_idx)];
% r_hat   = r_vec / norm(r_vec);
% 
% % Points on inner and outer at mid
% pt_i = [xi(mid_idx), yi(mid_idx)];
% pt_o = [xo(mid_idx), yo(mid_idx)];
% t_actual = norm(pt_o - pt_i);
